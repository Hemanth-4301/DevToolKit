VITE_GEMINI_API_KEY_1="your-gemini-api-key-1"
VITE_GEMINI_API_KEY_2="your-gemini-api-key-2"
VITE_GEMINI_API_KEY_3="your-gemini-api-key-3"

# Server-side only — used by the /api/share* serverless functions.
# NEVER prefix this with VITE_, and never reference it from src/.
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB="devtoolkit"

# Server-side only — used by /api/admin* serverless functions to sign
# admin session cookies. Must be a long random string, e.g. generate one
# with `openssl rand -hex 32`. NEVER prefix this with VITE_, and never
# reference it from src/.
ADMIN_SESSION_SECRET="replace-with-a-long-random-secret"
